# Copier en .env.local (jamais commité) puis redémarrer le serveur.

# Brouillon IA (OpenRouter). Sans clé, l'application fonctionne sans IA.
OPENROUTER_API_KEY=
# Modèle multimodal (audio + images + sorties JSON). Défaut : google/gemini-3.8-flash
# OPENROUTER_MODEL=google/gemini-3.8-flash

# Emplacements des données locales (défauts ci-dessous).
# DATABASE_PATH=data/devis.sqlite
# MEDIA_DIR=data/media
